use alienfile;

# Alien::TinyCDB build recipe (Alien::Build path).
#
# Provides Michael Tokarev's TinyCDB (corpit.ru cdb) C library to Perl
# consumers through cflags / libs / dynamic_libs. Probe for a usable system
# install first; otherwise fetch upstream and build from source.

# System detection: upstream's `make install` ships a pkg-config file
# (libcdb.pc), so pkg-config is the honest probe + sys gather. If a usable
# system TinyCDB is found the share block below is skipped entirely.
plugin 'PkgConfig' => (
  pkg_name => 'libcdb',
);

share {

  # Upstream is fetched at build time, not vendored. The release is pinned to
  # one tarball over https and verified against its SHA256 (a future
  # Alien::Build dies on an insecure fetch without a digest). A newer upstream
  # release is picked up by bumping the file name and the digest together; the
  # digest is the SHA256 of tinycdb-0.81.tar.gz as served by corpit.ru.
  start_url 'https://www.corpit.ru/mjt/tinycdb/tinycdb-0.81.tar.gz';
  plugin 'Download' => (
    url => 'https://www.corpit.ru/mjt/tinycdb/tinycdb-0.81.tar.gz',
    ssl => 1,
  );
  plugin 'Digest' => [
    SHA256 => '469de2d445bf54880f652f4b6dc95c7cdf6f5502c35524a45b2122d70d47ebc2',
  ];
  plugin 'Extract' => 'tar.gz';

  # TinyCDB ships a plain hand-written Makefile (no ./configure). Its default
  # `all: static` target builds only the static libcdb.a plus the cdb binary,
  # and with the normal CFLAGS, i.e. without -fPIC. ->libs links that archive,
  # and an XS consumer links it into a Perl shared object, which fails with
  # "relocation R_X86_64_32 ... recompile with -fPIC" on toolchains that do not
  # default to PIE. Hence CFLAGS carries -fPIC for the static archive too.
  #
  # The shared library lives behind the separate `sharedlib` /
  # `install-sharedlib` targets, which upstream marks GNU CC/LD specific
  # (-shared, -Wl,--soname=, -Wl,--version-script=). It is built for
  # ->dynamic_libs (FFI::Platypus), but on a linker that does not know those
  # flags it must not take the static build, i.e. the XS path, down with it:
  # there it is skipped with a warning and ->dynamic_libs stays empty.
  # The prefix is the staging install prefix supplied by Alien::Build; never
  # hardcode a path.
  my @make = ('%{make}', 'prefix=%{.install.prefix}', 'CFLAGS=-O2 -fPIC');
  build [
    [ @make, 'static' ],
    [ @make, 'install' ],
    sub {
      my ($build) = @_;
      my @m = ('%{make}', 'prefix=' . $build->install_prop->{prefix}, 'CFLAGS=-O2 -fPIC');
      my $ok = eval {
        $build->system(@m, 'sharedlib');
        $build->system(@m, 'install-sharedlib');
        1;
      };
      $build->log("warning: shared libcdb not built, ->dynamic_libs will be empty: $@")
        unless $ok;
    },
  ];

  # Move the shared libraries into their own dynamic/ directory, keeping
  # ->libs (static link against libcdb.a) and ->dynamic_libs (the .so, for
  # FFI) cleanly separate.
  plugin 'Gather::IsolateDynamic';

  # Gather the consumer flags from the staging prefix. Alien::Base rewrites
  # the staging prefix to the final dist_dir at runtime (see Alien::Base
  # _flags relocation), so these stay correct after install.
  gather sub {
    my ($build) = @_;
    my $prefix = $build->runtime_prop->{prefix};
    $build->runtime_prop->{cflags} = "-I$prefix/include";
    $build->runtime_prop->{libs}   = "-L$prefix/lib -lcdb";
  };

};
